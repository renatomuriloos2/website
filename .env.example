NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo para el servidor — NUNCA la expongas con el prefijo NEXT_PUBLIC_.
# Se usa para crear/eliminar cuentas y cambiar contraseñas desde Gestión de
# usuarios (Supabase → Project Settings → API → service_role).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Recordatorios de visita por correo (opcional). Sin esto, el resto de la
# app funciona igual — solo no se enviarán los recordatorios.
# API key de resend.com → API Keys.
RESEND_API_KEY=tu-resend-api-key
# Dirección remitente: necesita un dominio propio verificado en Resend
# (resend.com → Domains) para poder enviar a clientes reales. Mientras no
# verifiques un dominio, deja esto vacío — se usa onboarding@resend.dev, que
# solo entrega a la cuenta dueña de la API key (útil nada más para probar).
RESEND_FROM_EMAIL=notificaciones@tudominio.com
# Protege /api/cron/visit-reminders de invocaciones públicas. Genera un
# valor aleatorio (ej. `openssl rand -hex 24`) y ponlo también en Vercel →
# Project Settings → Environment Variables.
CRON_SECRET=un-valor-aleatorio-largo
