# ─── Fanatics QC Lab ──────────────────────────────────────────────
# Leave the Supabase values EMPTY to run in DEMO MODE (in-memory sample data,
# one-click demo logins). Fill them to run against the real database.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed app (used in e-mail links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mail notifications (optional) — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=qc-lab@yourdomain.com

# Force demo mode even if Supabase vars are set (true/false)
DEMO_MODE=

# Require TOTP two-factor for every account (recommended: true)
MFA_REQUIRED=true

# Show the "Explore demo" toggle on the login screen when Supabase is configured (default: true)
DEMO_SWITCH=true

# Web push notifications (optional). Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:qc-lab@yourdomain.com
